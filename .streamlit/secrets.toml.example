# Firebase 設定範本
# 請複製此檔案為 secrets.toml 並填入您的 Firebase 設定

# ===========================================
# Firebase Console 設定步驟：
# ===========================================
# 1. 前往 https://console.firebase.google.com/
# 2. 使用 luluopenclaw0110@gmail.com 登入
# 3. 建立新專案「ai-chatroom」
# 4. 啟用 Realtime Database
# 5. 在「專案設定」→「服務帳號」產生私密金鑰
# 6. 將 JSON 內容填入下方
# ===========================================

[firebase]
# 您的 Firebase 資料庫 URL（必填）
database_url = "https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com"

# Firebase Web App 設定（可選，用於進階功能）
api_key = "YOUR-API-KEY"
auth_domain = "YOUR-PROJECT-ID.firebaseapp.com"
project_id = "YOUR-PROJECT-ID"
storage_bucket = "YOUR-PROJECT-ID.appspot.com"
messaging_sender_id = "YOUR-SENDER-ID"
app_id = "YOUR-APP-ID"

# ===========================================
# 資料庫測試規則（僅供測試使用）
# ===========================================
# 在 Firebase Console → Realtime Database → 規則
# 設為：
# {
#   "rules": {
#     ".read": true,
#     ".write": true
#   }
# }
# ===========================================
